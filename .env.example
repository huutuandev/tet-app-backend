# ======================
# DATABASE (MySQL Docker)
# ======================
DB_URL=jdbc:mysql://mysql:3306/your_database_name?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ======================
# REDIS
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ======================
# JWT
# ======================
JWT_SECRET=your_jwt_secret_key

# ======================
# EMAIL (GMAIL SMTP - APP PASSWORD)
# ======================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password


UPLOAD_DIR=/data/uploads/images
UPLOAD_PUBLIC_URL=https://api.tet-fun-app.online
# ======================
# GOOGLE OAUTH2
# ======================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ======================
# FRONTEND
# ======================
FRONTEND_OAUTH_CALLBACK=http://localhost:3000/oauth2/callback

# ======================
# SPRING PROFILE
# ======================
SPRING_PROFILES_ACTIVE=prod #local
